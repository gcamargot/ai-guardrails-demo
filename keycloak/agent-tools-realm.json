        }
      ]
    },
    {
      "name": "smart_lock.write",
      "description": "Short-lived Turn Capability for exact Owner smart-lock Approval",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"},
      "protocolMappers": [
        {
          "name": "authenticated-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {"access.token.claim": "true", "lightweight.claim": "true", "introspection.token.claim": "true"}
        },
        {
          "name": "agent-tools-gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {"included.client.audience": "agent-tools-gateway", "id.token.claim": "false", "access.token.claim": "true", "lightweight.claim": "true", "introspection.token.claim": "true"}
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "agent-tools-gateway",
      "name": "Agent Tool Gateway audience",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "telegram-agent",
      "name": "Telegram agent demo Actor",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "telegram-demo-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["coffee_station.read", "calendar.free_busy.read", "calendar.meeting.propose"],
      "optionalClientScopes": ["calendar.meeting.approve", "outlook.mail.read", "smart_lock.write"]
    },
    {
      "clientId": "coding-agent",
      "name": "Coding agent demo Actor",
      "enabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "protocol": "openid-connect",
		"defaultClientScopes": ["coffee_station.read", "dev.repository.read"],
		"optionalClientScopes": ["smart_lock.write"],
		"redirectUris": ["http://127.0.0.1:*", "http://localhost:*"]
    }
  ],
  "users": [
    {
      "id": "owner-subject-id",
      "username": "owner",
      "firstName": "Demo",
      "lastName": "Owner",
      "email": "owner@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "owner-demo-password",
          "temporary": false
        }
      ]
    },
    {
      "id": "external-alice-subject-id",
      "username": "external-alice",
      "firstName": "External",
      "lastName": "Alice",
      "email": "external-alice@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "external-demo-password",
          "temporary": false
        }
      ]
    }
  ]
}
